# Supabase (used for authentication and per-user conversation history)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Channel3 server-side key. Keep this unprefixed by NEXT_PUBLIC_.
CHANNEL3_API_KEY=YOUR_CHANNEL3_API_KEY
# Alternative variable name supported by the app:
# CHANNELV3_SECRET=YOUR_CHANNEL3_API_KEY
