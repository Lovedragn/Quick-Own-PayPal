PORT=8080

FRONTEND_ORIGINS=https://quick-own.vercel.app,http://localhost:3000,http://127.0.0.1:3000
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

CHANNEL3_API_KEY=YOUR_CHANNEL3_API_KEY

GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET

PAYPAL_CLIENT_ID=YOUR_PAYPAL_CLIENT_ID
PAYPAL_CLIENT_SECRET=YOUR_PAYPAL_CLIENT_SECRET
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# PayPal Webhook ID (from PayPal Developer Dashboard)
PAYPAL_WEBHOOK_ID=YOUR_PAYPAL_WEBHOOK_ID

# PayPal Return & Cancel Redirect URLs (pointing to Vercel frontend)
PAYPAL_RETURN_URL=https://quick-own.vercel.app/checkout/success
PAYPAL_CANCEL_URL=https://quick-own.vercel.app/checkout/cancelled

# Catalogue Currency
CATALOG_CURRENCY=USD
CATALOG_FALLBACK_CURRENCY=USD
